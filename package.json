{
	"name": "www",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"test": "bun test src",
		"verify": "bun scripts/verify.js",
		"lint": "bun --bun prettier --check . && bun --bun eslint .",
		"format": "bun --bun prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"katex": "^0.19.1",
		"mdsvex": "^0.12.8",
		"medium-zoom": "^1.1.2",
		"mermaid": "^12.3.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-footnotes": "2.0.0",
		"remark-math": "3.0.1",
		"satori": "^0.63.2",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.8"
	}
}
